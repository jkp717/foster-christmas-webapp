# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
#
# The .env file is loaded automatically when the app starts (see
# webapp/__init__.py). It is git-ignored, so your secrets stay out of version
# control. Do NOT commit your real .env.

# --- Flask app secret -----------------------------------------------------
# Signs session cookies and CSRF tokens. Use a long random value and keep it
# secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required in production (ProdConfig refuses to start without a real value).
SECRET_KEY=replace_with_a_long_random_value

# --- Admin login ----------------------------------------------------------
# A single shared admin account protects the /admin area. The password is
# stored ONLY as a hash, never in plaintext. Generate the hash by running:
#   python cli.py create-admin-hash
# then paste the printed value below. Change ADMIN_USERNAME if you like.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste_the_hash_from_create-admin-hash_here

# --- Read-only login (optional) -------------------------------------------
# A second shared account that can VIEW everything but may only edit
# comment/note-type fields (any field named Note, Notes, Comment, Comments,
# etc.). It cannot create or delete records. Generate its hash the same way:
#   python cli.py create-admin-hash
# Leave READONLY_PASSWORD_HASH blank to disable this account entirely.
READONLY_USERNAME=readonly
READONLY_PASSWORD_HASH=

# --- Database location ----------------------------------------------------
# Where the SQLite database file lives. IN PRODUCTION, point this at a path
# OUTSIDE the git checkout so deploys can never delete your data. Example:
#   DATABASE_PATH=/var/lib/holidayhopetree/webapp2.db
# Leave it unset for local development (defaults to ./instance/webapp2.db).
# DATABASE_PATH=/var/lib/holidayhopetree/webapp2.db
#
# Advanced: to use a different engine entirely (e.g. Postgres), set a full
# SQLAlchemy URL here instead; it overrides DATABASE_PATH.
# DATABASE_URL=postgresql://user:pass@localhost/holidayhopetree

# --- Authorize.Net (Accept Hosted) ---------------------------------------
# From the Merchant Interface:
#   Account > Security Settings > General Security Settings >
#     API Credentials & Keys
# Use your SANDBOX credentials while testing, then switch to LIVE credentials.
AUTHNET_API_LOGIN_ID=your_api_login_id_here
AUTHNET_TRANSACTION_KEY=your_transaction_key_here

# true  = use the Authorize.Net sandbox (for testing)
# false = use live/production (real money)
AUTHNET_SANDBOX=true

# --- PayPal (classic _donations flow, only used without a hosted button) --
# The PayPal account email that receives donations. Only needed as a
# fallback if PAYPAL_HOSTED_BUTTON_ID (in webapp/config.py) is left empty.
PAYPAL_BUSINESS=your_paypal_account_email@example.com

# --- Organization / contact info ------------------------------------------
# Shown across the public site (footer, donate page, drop-off instructions,
# privacy policy, etc). Kept out of version control since it's personal /
# organizational info, not app config.
CONTACT_NAME=Your Name
CONTACT_EMAIL=your_email@example.com
CONTACT_PHONE=555-555-5555

# IRS Employer Identification Number, from your 501(c)(3) determination
# letter. Shown on donation pages and the privacy policy for tax-receipt
# purposes.
EIN=00-0000000
